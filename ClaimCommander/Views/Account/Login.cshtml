@model ClaimCommander.Models.LoginViewModel

@{
    ViewData["Title"] = "Log in";
    Layout = "_LayoutSimple"; // Use a layout without nav links if preferred
}

<div class="login-container">
    <div class="text-center">
        <h1 class="brand-title">ClaimCommander</h1>
        <p class="brand-subtitle">Academic Claim Management System</p>
    </div>

    <form asp-action="Login" method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3 text-center"></div>

        <div class="form-floating mb-3">
            <input asp-for="Email" class="form-control" placeholder="name@example.com" />
            <label asp-for="Email">Email address</label>
            <span asp-validation-for="Email" class="text-danger"></span>
        </div>

        <div class="form-floating mb-4">
            <input asp-for="Password" type="password" class="form-control" placeholder="Password" />
            <label asp-for="Password">Password</label>
            <span asp-validation-for="Password" class="text-danger"></span>
        </div>

        <div class="d-grid gap-2">
            <button type="submit" class="btn btn-primary btn-lg">Sign in</button>
        </div>

        <div class="mt-4 text-center">
            <p class="small text-muted">
                Demo Credentials:<br>
                HR: hr@test.com / password<br>
                Lecturer: lecturer@test.com / password<br>
                Manager: manager@test.com / password<br>
				Coordinator: coord@test.com / password

            </p>
        </div>
    </form>
</div>